# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=your-openrouter-api-key-here
# One pinned model, so every run is answered by the same model (see README).
AGENT_MODEL=google/gemma-4-31b-it:free
# Sampling settings (recorded with every run). Leave empty for the defaults.
AGENT_TEMPERATURE=0.3
AGENT_TOP_P=1.0
AGENT_MAX_TOKENS=1024
# Optional: fixed seed, and one OpenRouter provider name (no fallbacks).
AGENT_SEED=
AGENT_PROVIDER=
# Runs per test case for run_eval.py (free tier: keep small, or use --runs)
RUNS_PER_CASE=5
